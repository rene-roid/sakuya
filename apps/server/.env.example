# Password-lock the site. Leave AUTH_ENABLED unset/false to keep it open.
AUTH_ENABLED=false
AUTH_SECRET=

# Interface to bind. Defaults to 127.0.0.1 (this machine only). Set to 0.0.0.0 to serve other
# machines on your network — do that together with AUTH_ENABLED=true, since the server exposes
# your whole library and can open a file manager on the host. Docker sets this for you.
# SAKUYA_HOST=0.0.0.0

# Set to true when serving over HTTPS, so the auth cookie is marked Secure. Left off by default
# because a Secure cookie is dropped over plain HTTP, which is a supported LAN setup.
# SAKUYA_HTTPS=true
