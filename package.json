{
  "name": "sakuya",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "bun run --cwd apps/server typecheck && bun run --cwd apps/web typecheck",
    "_comment_test": "--isolate is required: each server test file boots its own server and sqlite singleton",
    "test": "bun test --isolate"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "form-data": "^4.0.6"
  }
}
