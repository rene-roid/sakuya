# Copy to .env to use. Bun loads .env automatically, so there is nothing to install
# and no flag to pass — `./run.sh`, `bun dev` and `bun src/index.ts` all pick it up.
# .env is gitignored; this file is the committed reference.

# --- Server ------------------------------------------------------------------

# PORT=3777

# Interface to bind. Loopback by default so a fresh install isn't exposed to the
# network. Set 0.0.0.0 to reach it from other machines — preferably with auth on.
# SAKUYA_HOST=127.0.0.1

# Where the DB, thumbnails, uploads and models live. Unset, it is autodetected:
# ~/.sakuya if that exists, else apps/server/data. Setting it disables the
# in-app "move data dir" button in Settings > System.
# SAKUYA_DATA_DIR=/mnt/data/apps/sakuya/apps/server/data

# Mark the auth cookie Secure. Only with HTTPS in front — a Secure cookie is
# silently dropped over plain HTTP, which is a supported LAN setup.
# SAKUYA_HTTPS=true

# AUTH_ENABLED=true
# AUTH_SECRET=change-me

# --- Resource limits ----------------------------------------------------------
#
# The non-Docker counterpart to `cpus` and `mem_limit` in docker-compose.yml.
# Unset, every value below keeps the behaviour these had when they were hardcoded,
# so adding a .env with none of them set changes nothing.
#
# Read docs/SETUP.md#resource-limits before relying on the memory one: CPU can be
# capped properly from inside the process, memory cannot.

# CPU budget, in cores. Fractions allowed, same as Docker's `cpus`. Derives job
# concurrency and the ffmpeg / onnxruntime / libvips thread pools in one go.
# The default deployment runs at 2.
# SAKUYA_MAX_CPUS=2

# Memory ceiling: 2g, 512m, 1.5G, or a plain byte count.
#
# NOT enforced by the app itself — nothing a process sets on itself can be, and
# most of the memory here is outside the JS heap (libvips buffers, onnxruntime
# arenas, ffmpeg children). It is enforced when you start via ./run.sh on a
# systemd host, which puts the process in a cgroup with a real MemoryMax. The
# boot log states which of the two you actually got.
# SAKUYA_MAX_MEMORY=2g

# Set false to keep the in-app limits above but never wrap the process in a
# systemd scope.
# SAKUYA_HARD_LIMIT=false

# --- Per-subsystem overrides --------------------------------------------------
# Each one wins over the value SAKUYA_MAX_CPUS would derive. Reach for these when
# one subsystem is the problem, rather than lowering the whole budget.

# Background jobs (scan / tag / thumbnail / transcode) allowed to run at once.
# SAKUYA_JOB_CONCURRENCY=2

# ffmpeg -threads while transcoding. Thumbnail extraction is always 1 thread:
# decoding a single frame gains nothing from more.
# SAKUYA_FFMPEG_THREADS=1

# onnxruntime threads within one operator, while AI tagging. The tagger's
# dominant cost, and the first knob to lower if tagging starves everything else.
# SAKUYA_ONNX_THREADS=2

# libvips worker pool for sharp (thumbnails, tagger preprocessing). Can only
# lower it: sharp already defaults to 1 on glibc Linux, and a limit that raised
# the pool would not be a limit.
# SAKUYA_SHARP_CONCURRENCY=1
